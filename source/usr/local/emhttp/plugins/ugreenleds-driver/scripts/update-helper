#!/bin/bash
# Download the kernel module for the next unRAID version as soon as an OS update is staged.
# Replaces the UGREEN part of ich777's Plugin Update Helper, which still points to his archived repo.
# PACKAGES, CHANGES and NOTIFY can be overridden for testing.
PACKAGES="${PACKAGES:-/boot/config/plugins/ugreenleds-driver/packages}"
CHANGES="${CHANGES:-/boot/changes.txt}"
NOTIFY="${NOTIFY:-/usr/local/emhttp/plugins/dynamix/scripts/notify}"
PACKAGE="ugreen_leds"
LAST_ALERT=""

alert_once() {
  # inotifywait can fire several times per update, alert only once per kernel and message
  [ "${LAST_ALERT}" == "$1" ] && return
  LAST_ALERT="$1"
  ${NOTIFY} -e "UGREEN LED Driver" -d "$2" -i "$3"
}

while true
do
  # Keep the arguments in this order: unRAIDServer.plg kills every process matching
  # "inotifywait -q /boot/changes.txt -e move_self,delete_self" (to restart ich777's helper)
  # right before it unpacks the update, which used to end this loop for good.
  # If inotifywait fails anyway (killed, changes.txt missing), don't exit, check the file again.
  inotifywait -q -e move_self,delete_self,modify "${CHANGES}" >/dev/null 2>&1 || sleep 10

  # changes.txt gets replaced, wait for the new one
  for _ in $(seq 1 30); do
    [ -f "${CHANGES}" ] && break
    sleep 2
  done
  [ -f "${CHANGES}" ] || continue
  sleep 2

  if command -v pcregrep >/dev/null 2>&1; then
    NEW_KERNEL_V="$(pcregrep -oM '#?#? ?Linux kernel[\s]*?(-|\*)? ?version:?\s+\K\d+(\.\d+)+' "${CHANGES}" | sort -V | tail -1)"
  else
    NEW_KERNEL_V="$(grep -E -A2 "Linux kernel" "${CHANGES}" | grep -E "version" | awk '{print $3}' | grep "^[0-9]" | sort -V | tail -1)"
  fi
  NEW_KERNEL_V="${NEW_KERNEL_V%%-*}"
  NEW_UNRAID_V="$(head -2 "${CHANGES}" | grep -E "Version" | awk '{print $3}')"
  if [ -z "${NEW_KERNEL_V}" ]; then
    alert_once "nokernel-${NEW_UNRAID_V}" "Can't read the kernel version of unRAID v${NEW_UNRAID_V} from ${CHANGES}, the module will be downloaded on boot." "warning"
    continue
  fi
  [ "${NEW_KERNEL_V}" == "$(uname -r | cut -d- -f1)" ] && continue

  # ich777's helper empties packages/<kernel>/ when its UGREEN download fails, so let it finish first.
  # It has no shebang and runs as plain "sh", so look for the process holding the script open.
  for _ in $(seq 1 120); do
    find /proc/[0-9]*/fd -lname /usr/bin/plugin_update_helper 2>/dev/null | grep -q . || break
    sleep 5
  done

  DIR="${PACKAGES}/${NEW_KERNEL_V}"
  # already there (another event for the same update)
  EXISTING="$(ls "${DIR}/${PACKAGE}"-*.txz 2>/dev/null | sort -V | tail -1)"
  if [ -n "${EXISTING}" ] && [ -f "${EXISTING}.md5" ] \
    && [ "$(md5sum "${EXISTING}" | awk '{print $1}')" == "$(awk '{print $1}' "${EXISTING}.md5")" ]; then
    continue
  fi

  LAT_PACKAGE="$(wget -qO- "https://api.github.com/repos/RogerSik/unraid-ugreenleds-driver/releases/tags/${NEW_KERNEL_V}-Unraid" | jq -r '.assets[].name' 2>/dev/null | grep "${PACKAGE}" | grep -E -v '\.md5$' | sort -V | tail -1)"
  DL_URL="https://github.com/RogerSik/unraid-ugreenleds-driver/releases/download/${NEW_KERNEL_V}-Unraid"
  if [ -z "${LAT_PACKAGE}" ]; then
    alert_once "nopkg-${NEW_KERNEL_V}" "No package for kernel ${NEW_KERNEL_V} (unRAID v${NEW_UNRAID_V}) yet, the LEDs won't work after the reboot. Wait for the 'Build kernel modules' workflow or run it by hand." "alert"
    continue
  fi

  mkdir -p "${DIR}"
  if wget -q -O "${DIR}/${LAT_PACKAGE}" "${DL_URL}/${LAT_PACKAGE}" && wget -q -O "${DIR}/${LAT_PACKAGE}.md5" "${DL_URL}/${LAT_PACKAGE}.md5" \
    && [ "$(md5sum "${DIR}/${LAT_PACKAGE}" | awk '{print $1}')" == "$(awk '{print $1}' "${DIR}/${LAT_PACKAGE}.md5")" ]; then
    # old kernel's package stays until the next boot (rollback)
    LAST_ALERT=""
    ${NOTIFY} -e "UGREEN LED Driver" -d "Package for unRAID v${NEW_UNRAID_V} downloaded, ready to reboot. An UGREEN error from the Plugin Update Helper can be ignored."
  else
    rm -f "${DIR}/${LAT_PACKAGE}"*
    alert_once "dlfail-${NEW_KERNEL_V}" "Download of ${LAT_PACKAGE} failed, the module will be downloaded on boot (needs internet)." "alert"
  fi
done
